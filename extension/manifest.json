{
  "manifest_version": 3,
  "name": "ปั๊กปัก Connector",
  "version": "0.1.0",
  "description": "เชื่อมปั๊กปักกับ Shopee Affiliate ที่คุณล็อกอินไว้ใน Chrome",
  "key": "",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://affiliate.shopee.co.th/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ปั๊กปัก Connector"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://*.vercel.app/*"
    ]
  }
}